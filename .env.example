# Copy to .env to override. No secrets are needed by this app.
# Folder containing orders.json, warehouses.json, zones.json, catalog.json
DATA_DIR=./data
# Where the CLI writes its output (UTF-8, LF)
OUTPUT_FILE=./routes.txt
# Q2 option 3 (off when AVOID_WAREHOUSE is unset). See README / D-28, D-29
# AVOID_WAREHOUSE=WH-GA
# AVOID_UNTIL=2026-10-26T00:00:00-04:00
# AVOID_MAX_ZONE_DELTA=1
