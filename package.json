{
  "name": "warehouse-order-router",
  "version": "1.0.0",
  "description": "Routes each order to the closest warehouse that can ship it in one parcel (NestJS standalone CLI).",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "what-if": "ts-node src/part-b/what-if.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
